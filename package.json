{
  "name": "psx-portfolio-analyzer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Analyze PSX portfolio holdings from CSV trade data.",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n client,server -c cyan,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client && npm run build --workspace server",
    "build:vercel": "npm run build:vercel --workspace client && npm run build --workspace server",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run typecheck --workspace client && npm run typecheck --workspace server",
    "test": "npm run test --workspace server",
    "test:coverage": "npm run test:coverage --workspace server",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "npm run start --workspace server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.10.0",
    "typescript-eslint": "^8.72.2"
  }
}
